status_all() {
    [ -f "$CONF_FILE" ] && source "$CONF_FILE"
    echo "=================================================="
    echo "         WALLPAPER ENGINE & PLAYLISTS STATUS        "
    echo "=================================================="
    local title="None"
    local type="-"
    if [ -n "$WALLPAPER_ID" ]; then
        title=$(get_title "$WALLPAPER_ID")
        type=$(get_type "$WALLPAPER_ID")
    fi
    echo "• Active wall  : $title (ID: ${WALLPAPER_ID:-none}, Type: $type)"

    local is_fav="Non"
    if [ -n "$WALLPAPER_ID" ] && grep -qx "$WALLPAPER_ID" "$FAV_FILE" 2>/dev/null; then
        is_fav="Oui ⭐"
    fi
    local nb_favs=0
    [ -f "$FAV_FILE" ] && nb_favs=$(grep -cv '^$' "$FAV_FILE" 2>/dev/null || echo 0)
    echo "• Favori      : $is_fav ($nb_favs total favorite(s))"

    local nb_playlists=0
    if [ -d "$PLAYLIST_DIR" ]; then
        nb_playlists=$(find "$PLAYLIST_DIR" -maxdepth 1 -name "*.txt" | wc -l)
    fi
    echo "• Playlists   : $nb_playlists available playlist(s)"

    local is_run="Inactive"
    if [ -f "$PID_FILE" ]; then
        local pid
        pid=$(cat "$PID_FILE" 2>/dev/null)
        if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
            is_run="Active 🔄 (PID: $pid)"
        fi
    fi
    local interval="${ROTATION_INTERVAL:-10m}"
    local sec
    sec=$(parse_duration "$interval")
    local fmt
    fmt=$(format_duration "$sec")
    echo "• Rotation    : $is_run"
    echo "• Interval  : $fmt"
    echo "• Source      : ${ROTATION_SOURCE:-favorites}"
    echo "• Order       : ${ROTATION_ORDER:-random}"
    echo "=================================================="
}

# ==============================================================================
# FONCTIONS FAVORIS
# ==============================================================================
fav_add() {
    local target_id="$1"
    if [ -z "$target_id" ]; then
        # Use active wallpaper if no ID specified
        [ -f "$CONF_FILE" ] && source "$CONF_FILE"
        target_id="$WALLPAPER_ID"
    fi

    if [ -z "$target_id" ]; then
        echo "Error: No active wallpaper and no ID specified."
        echo "Usage : wallpaper-add fav <ID_STEAM>"
        return 1
    fi

    if [ ! -d "$WORKSHOP_DIR/$target_id" ]; then
        echo "Error: Steam ID $target_id does not exist in:"
        echo "  $WORKSHOP_DIR/$target_id"
        return 1
    fi

    if grep -qx "$target_id" "$FAV_FILE" 2>/dev/null; then
        local title
        title=$(get_title "$target_id")
        echo "⭐ The wallpaper '$title' (ID: $target_id) is already in your favorites."
        return 0
    fi

    echo "$target_id" >> "$FAV_FILE"
    sort -u "$FAV_FILE" -o "$FAV_FILE"
    local title
    title=$(get_title "$target_id")
    echo "⭐ Successfully added to favorites!"
    echo "• Title : $title"
    echo "• ID    : $target_id"
}

fav_remove() {
    local target_id="$1"
    if [ -z "$target_id" ]; then
        echo "Error: Specify an ID to remove from favorites."
        echo "Usage : wallpaper-add fav remove <ID_STEAM>"
        return 1
    fi

    if ! grep -qx "$target_id" "$FAV_FILE" 2>/dev/null; then
        echo "L'ID $target_id is not in your favorites."
        return 0
    fi

    grep -vFx "$target_id" "$FAV_FILE" > "$FAV_FILE.tmp" && mv "$FAV_FILE.tmp" "$FAV_FILE"
    local title
    title=$(get_title "$target_id")
    echo "✓ Wallpaper '$title' (ID: $target_id) removed from favorites."
}

fav_list() {
    [ -f "$CONF_FILE" ] && source "$CONF_FILE"
    echo "================================================================================"
    echo "                             YOUR FAVORITE WALLPAPERS                          "
    echo "================================================================================"
    if [ ! -f "$FAV_FILE" ] || [ ! -s "$FAV_FILE" ]; then
        echo "No favorites saved yet."
        echo "To add one : wallpaper-add fav <ID_STEAM>  ou  wallpaper-add fav"
        echo "================================================================================"
        return 0
    fi

    printf "  %-12s | %-8s | %s\n" "ID" "TYPE" "TITLE"
    echo "--------------------------------------------------------------------------------"
    while IFS= read -r id || [ -n "$id" ]; do
        id=$(echo "$id" | tr -d ' \r\n')
        [ -z "$id" ] && continue
        local title
        title=$(get_title "$id")
        local type
        type=$(get_type "$id")
        local star="⭐"
        if [ "$id" = "$WALLPAPER_ID" ]; then
            printf "▶ %-12s | %-8s | %s [ACTIVE]\n" "$id" "$type" "$title"
        else
            printf "  %-12s | %-8s | %s\n" "$id" "$type" "$title"
        fi
    done < "$FAV_FILE"
    echo "================================================================================"
}

fav_play() {
    local duration="$1"
    [ -n "$duration" ] && update_config_key "ROTATION_INTERVAL" "$duration"
    update_config_key "ROTATION_SOURCE" "favorites"
    "$DAEMON" restart "$duration" "favorites"
}

fav_pick() {
    if ! command -v fzf >/dev/null 2>&1; then
        echo "fzf is not installed."
        fav_list
        return 1
    fi
    if [ ! -f "$FAV_FILE" ] || [ ! -s "$FAV_FILE" ]; then
        echo "No favorites for now."
        return 0
    fi

    local lines=()
    while IFS= read -r id || [ -n "$id" ]; do
        id=$(echo "$id" | tr -d ' \r\n')
        [ -z "$id" ] && continue
        local title
        title=$(get_title "$id")
        lines+=("$id - $title")
    done < "$FAV_FILE"

    local choice
    choice=$(printf "%s\n" "${lines[@]}" | fzf --prompt="Choose a favorite : " --height=40%)
    if [ -n "$choice" ]; then
        local sel_id
        sel_id=$(echo "$choice" | awk '{print $1}')
        "$SET_WALLPAPER" "$sel_id"
    fi
}

# ==============================================================================
# FONCTIONS PLAYLISTS
# ==============================================================================
playlist_create() {
    local name="$1"
    if [ -z "$name" ]; then
        echo "Error: Specify a playlist name."
        echo "Example : wallpaper-add playlist create anime"
        return 1
    fi
    # Clean name
    name=$(echo "$name" | tr -cd 'a-zA-Z0-9_-')
    local file="$PLAYLIST_DIR/${name}.txt"
    if [ -f "$file" ]; then
        echo "The playlist '$name' already exists."
        return 0
    fi
    touch "$file"
    echo "✓ Playlist '$name' created successfully!"
    echo "To add wallpapers : wallpaper-add playlist add <ID> $name"
}

playlist_add() {
    local target_id="$1"
    local name="${2:-default}"

    # If 1st arg is omitted
    if [ -z "$target_id" ]; then
        [ -f "$CONF_FILE" ] && source "$CONF_FILE"
        target_id="$WALLPAPER_ID"
    fi

    if [ -z "$target_id" ]; then
        echo "Error: No active wallpaper and no ID specified."
        echo "Usage : wallpaper-add playlist add <ID> [nom_playlist]"
        return 1
    fi

    if [ ! -d "$WORKSHOP_DIR/$target_id" ]; then
        echo "Error: Steam ID $target_id does not exist in:"
        echo "  $WORKSHOP_DIR/$target_id"
        return 1
    fi

    name=$(echo "$name" | tr -cd 'a-zA-Z0-9_-')
    local file="$PLAYLIST_DIR/${name}.txt"
    touch "$file"

    if grep -qx "$target_id" "$file" 2>/dev/null; then
        local title
        title=$(get_title "$target_id")
        echo "The wallpaper '$title' (ID: $target_id) is already in the playlist '$name'."
        return 0
    fi

    echo "$target_id" >> "$file"
    sort -u "$file" -o "$file"
    local title
    title=$(get_title "$target_id")
    echo "✓ Added to the playlist '$name' successfully!"
    echo "• Title : $title"
    echo "• ID    : $target_id"
}

playlist_remove() {
    local target_id="$1"
    local name="${2:-default}"
    if [ -z "$target_id" ]; then
        echo "Error: Specify an ID to remove from the playlist."
        echo "Usage : wallpaper-add playlist remove <ID> [nom_playlist]"
        return 1
    fi

    name=$(echo "$name" | tr -cd 'a-zA-Z0-9_-')
    local file="$PLAYLIST_DIR/${name}.txt"
    if [ ! -f "$file" ] || ! grep -qx "$target_id" "$file" 2>/dev/null; then
        echo "L'ID $target_id is not present in the playlist '$name'."
        return 0
    fi

    grep -vFx "$target_id" "$file" > "$file.tmp" && mv "$file.tmp" "$file"
    local title
    title=$(get_title "$target_id")
    echo "✓ Wallpaper '$title' (ID: $target_id) removed from the playlist '$name'."
}

playlist_list() {
    echo "=================================================="
    echo "               PLAYLISTS LIST                "
    echo "=================================================="
    local count=0
    for f in "$PLAYLIST_DIR"/*.txt; do
        if [ -f "$f" ]; then
            local name
            name=$(basename "$f" .txt)
            local nb
            nb=$(grep -cv '^$' "$f" 2>/dev/null || echo 0)
            printf "• %-20s (%d fond(s))\n" "$name" "$nb"
            count=$((count + 1))
        fi
    done
    if [ "$count" -eq 0 ]; then
        echo "No playlist created."
        echo "To create a playlist : wallpaper-add playlist create <nom>"
    fi
    echo "=================================================="
}

playlist_show() {
    local name="${1:-default}"
    name=$(echo "$name" | tr -cd 'a-zA-Z0-9_-')
    local file="$PLAYLIST_DIR/${name}.txt"
    if [ ! -f "$file" ]; then
        echo "Erreur : The playlist '$name' does not exist."
        return 1
    fi

    [ -f "$CONF_FILE" ] && source "$CONF_FILE"
    echo "================================================================================"
    echo "                      PLAYLIST CONTENT : $name                            "
    echo "================================================================================"
    if [ ! -s "$file" ]; then
        echo "This playlist is empty."
        echo "Add a wallpaper : wallpaper-add playlist add <ID> $name"
        echo "================================================================================"
        return 0
    fi

    printf "  %-12s | %-8s | %s\n" "ID" "TYPE" "TITLE"
    echo "--------------------------------------------------------------------------------"
    while IFS= read -r id || [ -n "$id" ]; do
        id=$(echo "$id" | tr -d ' \r\n')
        [ -z "$id" ] && continue
        local title
        title=$(get_title "$id")
        local type
        type=$(get_type "$id")
        if [ "$id" = "$WALLPAPER_ID" ]; then
            printf "▶ %-12s | %-8s | %s [ACTIVE]\n" "$id" "$type" "$title"
        else
            printf "  %-12s | %-8s | %s\n" "$id" "$type" "$title"
        fi
    done < "$file"
    echo "================================================================================"
}

playlist_delete() {
    local name="$1"
    if [ -z "$name" ]; then
        echo "Error: Specify the name of the playlist to delete."
        return 1
    fi
    name=$(echo "$name" | tr -cd 'a-zA-Z0-9_-')
    local file="$PLAYLIST_DIR/${name}.txt"
    if [ -f "$file" ]; then
        rm -f "$file"
        echo "✓ Playlist '$name' deleted."
    else
        echo "The playlist '$name' does not exist."
    fi
}

playlist_play() {
    local name="${1:-default}"
    local duration="$2"
    name=$(echo "$name" | tr -cd 'a-zA-Z0-9_-')
    local file="$PLAYLIST_DIR/${name}.txt"
    if [ ! -f "$file" ] || [ ! -s "$file" ]; then
        echo "Erreur : The playlist '$name' is empty or does not exist."
        return 1
    fi
    update_config_key "ACTIVE_PLAYLIST" "$name"
    update_config_key "ROTATION_SOURCE" "playlist:$name"
    [ -n "$duration" ] && update_config_key "ROTATION_INTERVAL" "$duration"
    "$DAEMON" restart "$duration" "playlist:$name"
}

playlist_pick() {
    local name="${1:-default}"
    name=$(echo "$name" | tr -cd 'a-zA-Z0-9_-')
    local file="$PLAYLIST_DIR/${name}.txt"
    if ! command -v fzf >/dev/null 2>&1; then
        echo "fzf is not available."
        playlist_show "$name"
        return 1
    fi
    if [ ! -f "$file" ] || [ ! -s "$file" ]; then
        echo "The playlist '$name' is empty or not found."
        return 0
    fi

    local lines=()
    while IFS= read -r id || [ -n "$id" ]; do
        id=$(echo "$id" | tr -d ' \r\n')
        [ -z "$id" ] && continue
        local title
        title=$(get_title "$id")
        lines+=("$id - $title")
    done < "$file"

    local choice
    choice=$(printf "%s\n" "${lines[@]}" | fzf --prompt="Playlist ($name) : " --height=40%)
    if [ -n "$choice" ]; then
        local sel_id
        sel_id=$(echo "$choice" | awk '{print $1}')
        "$SET_WALLPAPER" "$sel_id"
    fi
}

# ==============================================================================
# FONCTIONS TIMER / INTERVALLE DE CHANGEMENT
# ==============================================================================
timer_set() {
    local str="$1"
    if [ -z "$str" ]; then
        "$DAEMON" status
        return 0
    fi

    local sec
    sec=$(parse_duration "$str")
    if [ "$sec" -le 0 ]; then
        echo "Error: Invalid duration '$str'."
        echo "Examples: 5m, 10m, 30m, 1h, 45s, ou 15 (minutes)"
        return 1
    fi

    update_config_key "ROTATION_INTERVAL" "$str"
    local fmt
    fmt=$(format_duration "$sec")
    echo "✓ Interval set to : $fmt ($sec secondes)."
    echo "Restarting rotation..."
    "$DAEMON" restart "$str"
}

# Global visual search (fzf)
pick_global() {
    if ! command -v fzf >/dev/null 2>&1; then
        echo "fzf is not installed."
        "$SET_WALLPAPER" --list
        return 1
    fi

    local lines=()
    for d in "$WORKSHOP_DIR"/*; do
        if [ -d "$d" ] && [ -f "$d/project.json" ]; then
            local id
            id=$(basename "$d")
            local title
            title=$(get_title "$id")
            local type
            type=$(get_type "$id")
            lines+=("$id | $type | $title")
        fi
    done

    local choice
    choice=$(printf "%s\n" "${lines[@]}" | fzf --prompt="Choose a wallpaper : " --height=50%)
    if [ -n "$choice" ]; then
        local sel_id
        sel_id=$(echo "$choice" | awk '{print $1}')
        "$SET_WALLPAPER" "$sel_id"
    fi
}

# ==============================================================================
# ROUTEUR PRINCIPAL
# ==============================================================================
if [ $# -eq 0 ]; then
    show_help
    status_all
    exit 0
fi

CMD="$1"
shift

case "$CMD" in
    -h|--help|help)
        show_help
        exit 0
        ;;
    status|--status)
        status_all
        exit 0
        ;;
    # GESTION DES FAVORIS
    fav|--fav|favorite|favorites)
        sub="$1"
        if [ -z "$sub" ]; then
            # wallpaper-add fav -> ajoute le fond actif aux favoris
            fav_add
        elif [[ "$sub" =~ ^[0-9]+$ ]]; then
            # wallpaper-add fav <ID>
            fav_add "$sub"
        else
            shift
            case "$sub" in
                add)
                    fav_add "$1"
                    ;;
                rm|remove|delete|del|unfav)
                    fav_remove "$1"
                    ;;
                list|ls)
                    fav_list
                    ;;
                play)
                    fav_play "$1"
                    ;;
                pick)
                    fav_pick
                    ;;
                *)
                    echo "Unknown subcommand for fav : $sub"
                    echo "Commands : fav add <ID>, fav rm <ID>, fav list, fav play [t]"
                    exit 1
                    ;;
            esac
        fi
        ;;
    unfav|--unfav)
        fav_remove "$1"
        ;;
    fav-list|--fav-list)
        fav_list
        ;;
    # GESTION DES PLAYLISTS
    playlist|--playlist|pl)
        sub="$1"
        if [ -z "$sub" ]; then
            playlist_list
        elif [[ "$sub" =~ ^[0-9]+$ ]]; then
            # wallpaper-add playlist <ID> [nom]
            shift
            playlist_add "$sub" "$1"
        else
            shift
            case "$sub" in
                create|new)
                    playlist_create "$1"
                    ;;
                add)
                    playlist_add "$1" "$2"
                    ;;
                rm|remove|delete|del)
                    if [[ "$1" =~ ^[0-9]+$ ]]; then
                        playlist_remove "$1" "$2"
                    else
                        playlist_delete "$1"
                    fi
                    ;;
                list|ls)
                    if [ -n "$1" ]; then
                        playlist_show "$1"
                    else
                        playlist_list
                    fi
                    ;;
                show)
                    playlist_show "$1"
                    ;;
                play)
                    playlist_play "$1" "$2"
                    ;;
                pick)
                    playlist_pick "$1"
                    ;;
                *)
                    # If it's an existing playlist name, display it
                    if [ -f "$PLAYLIST_DIR/${sub}.txt" ]; then
                        playlist_show "$sub"
                    else
                        echo "Unknown subcommand for playlist : $sub"
                        echo "Commands : playlist create <nom>, playlist add <ID> [nom], playlist list, playlist play <nom>"
                        exit 1
                    fi
                    ;;
            esac
        fi
        ;;
    # GESTION DU TIMER / ROTATION
    timer|--timer|interval|--interval)
        sub="$1"
        if [ -z "$sub" ]; then
            "$DAEMON" status
        elif [ "$sub" = "start" ]; then
            shift
            "$DAEMON" start "$1" "$2" "$3"
        elif [ "$sub" = "stop" ]; then
            "$DAEMON" stop
        elif [ "$sub" = "status" ]; then
            "$DAEMON" status
        elif [ "$sub" = "restart" ]; then
            shift
            "$DAEMON" restart "$@"
        elif [ "$sub" = "notify" ]; then
            shift
            if [ "$1" = "on" ] || [ "$1" = "true" ] || [ "$1" = "1" ]; then
                update_config_key "ROTATION_NOTIFY" "true"
                echo "✓ Desktop notifications enabled."
            else
                update_config_key "ROTATION_NOTIFY" "false"
                echo "✓ Desktop notifications disabled."
            fi
        else
            # wallpaper-add timer 10m
            timer_set "$sub"
        fi
        ;;
    timer-stop|--timer-stop|stop-timer)
        "$DAEMON" stop
        ;;
    # QUICK CONTROLS
    next|--next)
        "$DAEMON" next
        ;;
    prev|--prev)
        "$DAEMON" prev
        ;;
    random|--random|rand)
        "$DAEMON" random
        ;;
    order|--order)
        if [ "$1" = "seq" ] || [ "$1" = "sequential" ]; then
            update_config_key "ROTATION_ORDER" "sequential"
            echo "✓ Rotation order set to : sequential"
        else
            update_config_key "ROTATION_ORDER" "random"
            echo "✓ Rotation order set to : random"
        fi
        ;;
    pick|select|fzf)
        pick_global
        ;;
    *)
        # If it's a number (Steam ID)
        if [[ "$CMD" =~ ^[0-9]+$ ]]; then
            fav_add "$CMD"
            echo ""
            echo "Tips :"
            echo "• To apply it now : set-wallpaper $CMD"
            echo "• To add it to a playlist: wallpaper-add playlist add $CMD <nom>"
        else
            echo "Unknown command : $CMD"
            echo ""
            show_help
            exit 1
        fi
        ;;
esac
