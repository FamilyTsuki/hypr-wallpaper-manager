#!/bin/bash

# ==============================================================================
# wallpaper-add : Playlist, favorites and timer manager for Wallpaper Engine
# ==============================================================================

BASE_DIR="$HOME/.config/hypr/wallpaper_engine"
CONF_FILE="$HOME/.config/hypr/wallpaper_engine.conf"
WORKSHOP_DIR="$HOME/.local/share/Steam/steamapps/workshop/content/431960"
PID_FILE="$BASE_DIR/rotation.pid"
LOG_FILE="$BASE_DIR/rotation.log"
FAV_FILE="$BASE_DIR/favorites.txt"
HISTORY_FILE="$BASE_DIR/history.txt"
PLAYLIST_DIR="$BASE_DIR/playlists"
SET_WALLPAPER="set-wallpaper"
DAEMON="wallpaper-daemon"

mkdir -p "$BASE_DIR" "$PLAYLIST_DIR"
touch "$FAV_FILE" "$HISTORY_FILE"

# Load saved configuration
if [ -f "$CONF_FILE" ]; then
    # shellcheck source=/dev/null
    source "$CONF_FILE"
fi

get_title() {
    local id="$1"
    local proj="$WORKSHOP_DIR/$id/project.json"
    if [ -f "$proj" ]; then
        jq -r '.title // "Untitled"' "$proj" 2>/dev/null || echo "Untitled"
    else
        echo "Unknown"
    fi
}

get_type() {
    local id="$1"
    local proj="$WORKSHOP_DIR/$id/project.json"
    if [ -f "$proj" ]; then
        jq -r '.type // "unknown"' "$proj" 2>/dev/null || echo "unknown"
    else
        echo "unknown"
    fi
}

update_config_key() {
    local key="$1"
    local val="$2"
    if [ ! -f "$CONF_FILE" ]; then
        touch "$CONF_FILE"
    fi
    if grep -q "^${key}=" "$CONF_FILE" 2>/dev/null; then
        sed -i "s|^${key}=.*|${key}=\"${val}\"|" "$CONF_FILE"
    else
        echo "${key}=\"${val}\"" >> "$CONF_FILE"
    fi
}

parse_duration() {
    local str="$1"
    str=$(echo "$str" | tr '[:upper:]' '[:lower:]' | tr -d ' ')
    if [[ "$str" =~ ^([0-9]+)s$ ]]; then
        echo "${BASH_REMATCH[1]}"
    elif [[ "$str" =~ ^([0-9]+)m$ ]]; then
        echo "$((BASH_REMATCH[1] * 60))"
    elif [[ "$str" =~ ^([0-9]+)h$ ]]; then
        echo "$((BASH_REMATCH[1] * 3600))"
    elif [[ "$str" =~ ^([0-9]+)d$ ]]; then
        echo "$((BASH_REMATCH[1] * 86400))"
    elif [[ "$str" =~ ^([0-9]+)$ ]]; then
        echo "$((str * 60))"
    else
        echo "-1"
    fi
}

format_duration() {
    local s="$1"
    if [ "$s" -ge 3600 ]; then
        local h=$((s / 3600))
        local m=$(((s % 3600) / 60))
        if [ "$m" -gt 0 ]; then
            echo "${h}h ${m}m"
        else
            echo "${h}h"
        fi
    elif [ "$s" -ge 60 ]; then
        local m=$((s / 60))
        local sec=$((s % 60))
        if [ "$sec" -gt 0 ]; then
            echo "${m}m ${sec}s"
        else
            echo "${m}m"
        fi
    else
        echo "${s}s"
    fi
}

show_help() {
    echo "================================================================================"
    echo "       WALLPAPER-ADD : Playlists, Favorites & Rotation Management               "
    echo "================================================================================"
    echo "Usage: wallpaper-add [COMMANDE] [ARGUMENTS]"
    echo ""
    echo "⭐ FAVORITES MANAGEMENT :"
    echo "  wallpaper-add fav                       Add active wallpaper to favorites"
    echo "  wallpaper-add fav <ID>                  Add specified ID to favorites"
    echo "  wallpaper-add fav add <ID>              Add specified ID to favorites"
    echo "  wallpaper-add fav remove <ID>           Remove ID from favorites (alias: rm, unfav)"
    echo "  wallpaper-add fav list                  Liste tous vos favoris"
    echo "  wallpaper-add fav play [duration]          Start automatic rotation on favorites"
    echo "  wallpaper-add fav pick                  Choose a favorite interactively (fzf)"
    echo ""
    echo "📂 PLAYLIST MANAGEMENT :"
    echo "  wallpaper-add playlist create <nom>     Create a new playlist"
    echo "  wallpaper-add playlist add <ID> [nom]   Add a wallpaper (default: 'default')"
    echo "  wallpaper-add playlist remove <ID> [n]  Remove a wallpaper from a playlist (alias: rm)"
    echo "  wallpaper-add playlist list             List all existing playlists"
    echo "  wallpaper-add playlist show <nom>       Display playlist content"
    echo "  wallpaper-add playlist play <nom> [t]   Start automatic rotation on the playlist"
    echo "  wallpaper-add playlist delete <nom>     Delete a playlist"
    echo "  wallpaper-add playlist pick [nom]       Choose a wallpaper from the playlist (fzf)"
    echo ""
