    echo "  wallpaper-add fav add <ID>              Ajoute l'ID spécifié aux favoris"
    echo "  wallpaper-add fav remove <ID>           Retire l'ID des favoris (alias: rm, unfav)"
    echo "  wallpaper-add fav list                  Liste tous vos favoris"
    echo "  wallpaper-add fav play [durée]          Lance le diaporama automatique sur les favoris"
    echo "  wallpaper-add fav pick                  Choisit un favori interactivement (fzf)"
