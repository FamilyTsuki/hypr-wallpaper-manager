#!/bin/bash

# ==============================================================================
# wallpaper-add : Gestionnaire de playlists, favoris et timer pour Wallpaper Engine
# ==============================================================================

BASE_DIR="$HOME/.config/hypr/wallpaper_engine"
CONF_FILE="$HOME/.config/hypr/wallpaper_engine.conf"
WORKSHOP_DIR="$HOME/.local/share/Steam/steamapps/workshop/content/431960"
PID_FILE="$BASE_DIR/rotation.pid"
LOG_FILE="$BASE_DIR/rotation.log"
FAV_FILE="$BASE_DIR/favorites.txt"
HISTORY_FILE="$BASE_DIR/history.txt"
PLAYLIST_DIR="$BASE_DIR/playlists"
SET_WALLPAPER="set-wallpaper"
DAEMON="wallpaper-daemon"

mkdir -p "$BASE_DIR" "$PLAYLIST_DIR"
touch "$FAV_FILE" "$HISTORY_FILE"

# Charger la configuration enregistrée
if [ -f "$CONF_FILE" ]; then
    # shellcheck source=/dev/null
    source "$CONF_FILE"
fi

get_title() {
    local id="$1"
    local proj="$WORKSHOP_DIR/$id/project.json"
    if [ -f "$proj" ]; then
        jq -r '.title // "Sans titre"' "$proj" 2>/dev/null || echo "Sans titre"
    else
        echo "Inconnu"
    fi
}

get_type() {
    local id="$1"
    local proj="$WORKSHOP_DIR/$id/project.json"
    if [ -f "$proj" ]; then
        jq -r '.type // "inconnu"' "$proj" 2>/dev/null || echo "inconnu"
    else
        echo "inconnu"
    fi
}

update_config_key() {
    local key="$1"
    local val="$2"
    if [ ! -f "$CONF_FILE" ]; then
        touch "$CONF_FILE"
    fi
    if grep -q "^${key}=" "$CONF_FILE" 2>/dev/null; then
        sed -i "s|^${key}=.*|${key}=\"${val}\"|" "$CONF_FILE"
    else
        echo "${key}=\"${val}\"" >> "$CONF_FILE"
    fi
}

parse_duration() {
    local str="$1"
    str=$(echo "$str" | tr '[:upper:]' '[:lower:]' | tr -d ' ')
    if [[ "$str" =~ ^([0-9]+)s$ ]]; then
        echo "${BASH_REMATCH[1]}"
    elif [[ "$str" =~ ^([0-9]+)m$ ]]; then
        echo "$((BASH_REMATCH[1] * 60))"
    elif [[ "$str" =~ ^([0-9]+)h$ ]]; then
        echo "$((BASH_REMATCH[1] * 3600))"
    elif [[ "$str" =~ ^([0-9]+)d$ ]]; then
        echo "$((BASH_REMATCH[1] * 86400))"
    elif [[ "$str" =~ ^([0-9]+)$ ]]; then
        echo "$((str * 60))"
    else
        echo "-1"
    fi
}

format_duration() {
    local s="$1"
    if [ "$s" -ge 3600 ]; then
        local h=$((s / 3600))
        local m=$(((s % 3600) / 60))
        if [ "$m" -gt 0 ]; then
            echo "${h}h ${m}m"
        else
            echo "${h}h"
        fi
    elif [ "$s" -ge 60 ]; then
        local m=$((s / 60))
        local sec=$((s % 60))
        if [ "$sec" -gt 0 ]; then
            echo "${m}m ${sec}s"
        else
            echo "${m}m"
        fi
    else
        echo "${s}s"
    fi
}

