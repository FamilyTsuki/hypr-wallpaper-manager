#!/bin/bash

# ==============================================================================
# set-wallpaper : Apply and configure Wallpaper Engine wallpapers
# ==============================================================================

WORKSHOP_DIR="$HOME/.local/share/Steam/steamapps/workshop/content/431960"
ASSETS_DIR="$HOME/.local/share/Steam/steamapps/common/wallpaper_engine/assets"
LAUNCH_SCRIPT="$HOME/.config/hypr/launch_wallpaper.sh"
CONF_FILE="$HOME/.config/hypr/wallpaper_engine.conf"
BASE_DIR="$HOME/.config/hypr/wallpaper_engine"
FAV_FILE="$BASE_DIR/favorites.txt"
PLAYLIST_DIR="$BASE_DIR/playlists"
DAEMON="wallpaper-daemon"

# Default values
WALLPAPER_ID=""
FPS="60"
VOLUME="15"
SILENT="false"
SCALING="fill"
PAUSE_MODE="only-active"
ROTATION_ENABLED="false"
ROTATION_INTERVAL="10m"
ROTATION_SOURCE="favorites"
ROTATION_ORDER="random"
ROTATION_NOTIFY="false"
ACTIVE_PLAYLIST="default"
QUIET="false"

# Load saved configuration if exists
if [ -f "$CONF_FILE" ]; then
    # shellcheck source=/dev/null
    source "$CONF_FILE"
fi
PAUSE_MODE="${PAUSE_MODE:-only-active}"

function show_help() {
    echo "Usage: set-wallpaper [STEAM_ID] [OPTIONS]"
    echo ""
    echo "Wallpaper Management:"
    echo "  set-wallpaper <ID_STEAM>         Applies the wallpaper and updates startup config"
    echo "  set-wallpaper --list, -l         Lists all downloaded wallpapers"
    echo "  set-wallpaper --status, --info   Displays current settings and wallpaper"
    echo "  set-wallpaper --stop             Stops the animated wallpaper and rotation"
    echo "  set-wallpaper --restart          Restarts the wallpaper with saved settings"
    echo ""
    echo "Modify display settings:"
    echo "  --fps <valeur>                   Sets the framerate in FPS (e.g., 60, 30, 16)"
    echo "  --volume <0-100>                 Sets the volume level"
    echo "  --mute, --silent, -s             Mutes audio"
    echo "  --unmute                         Unmutes audio"
    echo "  --scaling <mode>                 Display mode (fill, fit, stretch)"
    echo "  --pause-only-active              Pause only if the fullscreen window is focused"
    echo "  --no-pause, --no-fullscreen-pause Never pause the wallpaper"
    echo "  --pause-all                      Pause when any fullscreen window exists"
    echo ""
    echo "Playlists, Favorites & Rotation (see also 'wallpaper-add'):"
    echo "  --fav [ID_STEAM]                 Add to favorites (default: active wallpaper)"
    echo "  --unfav <ID_STEAM>               Remove from favorites"
    echo "  --fav-list                       List all favorites"
    echo "  --playlist <nom> [play]          Play or select a playlist"
    echo "  --timer <duration>                  Set interval and enable rotation (e.g., 5m, 10m)"
    echo "  --timer-stop                     Stop automatic rotation"
    echo "  --next                           Skip to next wallpaper"
    echo "  --prev                           Go to previous wallpaper"
    echo "  --random                         Apply a random wallpaper"
    echo ""
    echo "Examples:"
    echo "  set-wallpaper 3599761711 --fps 60"
    echo "  set-wallpaper --fav"
    echo "  set-wallpaper --timer 10m"
    echo "  set-wallpaper --next"
    echo ""
}

function show_status() {
    echo "=================================================="
    echo "       CURRENT WALLPAPER CONFIGURATION     "
    echo "=================================================="
    if [ -z "$WALLPAPER_ID" ]; then
        echo "No active wallpaper configured."
        echo "=================================================="
        return
    fi
    local title="Unknown"
    local type="Unknown"
    local target_dir="$WORKSHOP_DIR/$WALLPAPER_ID"
    if [ -f "$target_dir/project.json" ]; then
        title=$(jq -r '.title // "Untitled"' "$target_dir/project.json" 2>/dev/null)
        type=$(jq -r '.type // "unknown"' "$target_dir/project.json" 2>/dev/null)
    fi
    echo "• Steam ID    : $WALLPAPER_ID"
    echo "• Title       : $title"
    echo "• Type        : $type"
    echo "• Framerate    : $FPS FPS"
    if [ "$SILENT" == "true" ]; then
        echo "• Audio       : Muted (disabled)"
    else
        echo "• Volume      : $VOLUME %"
    fi
    echo "• Scaling     : $SCALING"
    case "$PAUSE_MODE" in
        "only-active") echo "• Fullscreen : Pause only if window is active" ;;
        "none")        echo "• Fullscreen : Never pause" ;;
        "all")         echo "• Fullscreen : Global pause across all workspaces" ;;
        *)             echo "• Fullscreen : $PAUSE_MODE" ;;
    esac

    # Favori
    if [ -f "$FAV_FILE" ] && grep -qx "$WALLPAPER_ID" "$FAV_FILE" 2>/dev/null; then
        echo "• Favorite    : Yes ⭐"
    else
        echo "• Favorite    : No"
    fi

    # Rotation
    if [ "$ROTATION_ENABLED" = "true" ]; then
        echo "• Rotation    : Enabled ($ROTATION_INTERVAL, Source: $ROTATION_SOURCE)"
    else
        echo "• Rotation    : Disabled"
    fi
    echo "=================================================="
}

function list_wallpapers() {
    echo "Available wallpapers:"
    echo "--------------------------------------------------------------------------------"
    printf "%-12s | %-8s | %s\n" "ID" "TYPE" "TITLE"
    echo "--------------------------------------------------------------------------------"
    for dir in "$WORKSHOP_DIR"/*; do
        if [ -d "$dir" ]; then
            local id
            id=$(basename "$dir")
            local title="Unknown"
            local type="Unknown"
            if [ -f "$dir/project.json" ]; then
                title=$(jq -r '.title // "Untitled"' "$dir/project.json" 2>/dev/null)
                type=$(jq -r '.type // "unknown"' "$dir/project.json" 2>/dev/null)
            fi
            printf "%-12s | %-8s | %s\n" "$id" "$type" "$title"
        fi
    done
    echo "--------------------------------------------------------------------------------"
}

if [ $# -eq 0 ]; then
    show_help
    show_status
    exit 0
fi

NEW_ID=""
CHANGED=0

while [ $# -gt 0 ]; do
    case "$1" in
        -h|--help)
            show_help
            exit 0
            ;;
        -l|--list)
            list_wallpapers
            exit 0
            ;;
        -q|--quiet)
            QUIET="true"
            shift
            ;;
        --stop)
            killall -q linux-wallpaperengine
            if [ -x "$DAEMON" ]; then
                "$DAEMON" stop >/dev/null 2>&1
            fi
            echo "Animated wallpaper stopped."
            exit 0
            ;;
        --status|--info)
            show_status
            exit 0
            ;;
        --restart)
            CHANGED=1
            shift
            ;;
        --fps)
            if [ -n "$2" ] && [[ "$2" =~ ^[0-9]+$ ]]; then
                FPS="$2"
                CHANGED=1
                shift 2
            else
                echo "Error: FPS value must be an integer (e.g., --fps 60)."
                exit 1
            fi
            ;;
        --volume)
            if [ -n "$2" ] && [[ "$2" =~ ^[0-9]+$ ]]; then
                VOLUME="$2"
                SILENT="false"
                CHANGED=1
                shift 2
            else
                echo "Error: Volume must be between 0 and 100 (e.g., --volume 25)."
                exit 1
            fi
            ;;
        --mute|--silent|-s)
            SILENT="true"
            CHANGED=1
            shift
            ;;
        --unmute)
            SILENT="false"
            CHANGED=1
            shift
            ;;
        --scaling)
            if [ -n "$2" ]; then
                SCALING="$2"
                CHANGED=1
                shift 2
            else
                echo "Error: Specify a scaling mode (fill, fit, stretch)."
                exit 1
            fi
            ;;
        --pause-only-active)
            PAUSE_MODE="only-active"
            CHANGED=1
            shift
            ;;
        --no-pause|--no-fullscreen-pause)
            PAUSE_MODE="none"
            CHANGED=1
            shift
            ;;
        --pause-all)
            PAUSE_MODE="all"
            CHANGED=1
            shift
            ;;
        # OPTIONS DE ROTATION ET FAVORIS
        --fav)
            shift
            if [ -n "$1" ] && [[ "$1" =~ ^[0-9]+$ ]]; then
                wallpaper-add fav "$1"
                shift
            else
                wallpaper-add fav
            fi
            exit 0
            ;;
        --unfav)
            shift
            wallpaper-add fav remove "$1"
            exit 0
            ;;
        --fav-list)
            wallpaper-add fav list
            exit 0
            ;;
        --playlist)
            shift
            local pl_name="$1"
            shift
            if [ "$1" = "play" ]; then
                wallpaper-add playlist play "$pl_name" "$2"
            else
                wallpaper-add playlist list "$pl_name"
            fi
            exit 0
            ;;
        --timer)
            shift
            wallpaper-add timer "$1"
            exit 0
            ;;
        --timer-stop)
            wallpaper-add timer stop
            exit 0
            ;;
        --next)
            wallpaper-add next
            exit 0
            ;;
        --prev)
            wallpaper-add prev
            exit 0
            ;;
        --random)
            wallpaper-add random
            exit 0
            ;;
        *)
            if [[ "$1" =~ ^[0-9]+$ ]]; then
                NEW_ID="$1"
                CHANGED=1
                shift
            else
                echo "Unknown option: $1"
                echo ""
                show_help
                exit 1
            fi
            ;;
    esac
done

if [ "$CHANGED" -eq 0 ]; then
    show_help
    exit 0
fi

if [ -n "$NEW_ID" ]; then
    TARGET_DIR="$WORKSHOP_DIR/$NEW_ID"
    if [ ! -d "$TARGET_DIR" ]; then
        echo "Error: Wallpaper with ID $NEW_ID does not exist in:"
        echo "  $TARGET_DIR"
        echo "Check your Steam subscriptions and ensure the download is complete."
        exit 1
    fi
    WALLPAPER_ID="$NEW_ID"
fi

if [ -z "$WALLPAPER_ID" ]; then
    echo "Error: No active wallpaper. Specify a Steam ID: set-wallpaper <STEAM_ID>"
    exit 1
fi

TARGET_DIR="$WORKSHOP_DIR/$WALLPAPER_ID"
if [ ! -d "$TARGET_DIR" ]; then
    echo "Error: The folder for wallpaper $WALLPAPER_ID was not found."
    exit 1
fi

# Save full configuration
cat << EOF > "$CONF_FILE"
WORKSHOP_DIR="$WORKSHOP_DIR"
ASSETS_DIR="$ASSETS_DIR"
WALLPAPER_ID="$WALLPAPER_ID"
FPS="$FPS"
VOLUME="$VOLUME"
SILENT="$SILENT"
SCALING="$SCALING"
PAUSE_MODE="$PAUSE_MODE"
ROTATION_ENABLED="$ROTATION_ENABLED"
ROTATION_INTERVAL="$ROTATION_INTERVAL"
ROTATION_SOURCE="$ROTATION_SOURCE"
ROTATION_ORDER="$ROTATION_ORDER"
ROTATION_NOTIFY="$ROTATION_NOTIFY"
ACTIVE_PLAYLIST="$ACTIVE_PLAYLIST"
EOF

AUDIO_OPT="--volume $VOLUME"
if [ "$SILENT" == "true" ]; then
    AUDIO_OPT="--silent"
fi

PAUSE_OPT="--fullscreen-pause-only-active"
if [ "$PAUSE_MODE" == "none" ]; then
    PAUSE_OPT="--no-fullscreen-pause"
elif [ "$PAUSE_MODE" == "all" ]; then
    PAUSE_OPT=""
fi

# Update the launch script for Hyprland startup
cat << EOF > "$LAUNCH_SCRIPT"
#!/bin/bash
killall -q linux-wallpaperengine
sleep 0.2

CONF_FILE="$CONF_FILE"
if [ -f "\$CONF_FILE" ]; then
    # shellcheck source=/dev/null
    source "\$CONF_FILE"
fi

ASSETS_DIR="$ASSETS_DIR"
WORKSHOP_DIR="$WORKSHOP_DIR"
CURRENT_TARGET="\$WORKSHOP_DIR/\${WALLPAPER_ID:-$WALLPAPER_ID}"

AUDIO_OPT="--volume \${VOLUME:-$VOLUME}"
if [ "\${SILENT:-$SILENT}" = "true" ]; then
    AUDIO_OPT="--silent"
fi

PAUSE_OPT="--fullscreen-pause-only-active"
if [ "\${PAUSE_MODE:-$PAUSE_MODE}" = "none" ]; then
    PAUSE_OPT="--no-fullscreen-pause"
elif [ "\${PAUSE_MODE:-$PAUSE_MODE}" = "all" ]; then
    PAUSE_OPT=""
fi

MONITOR=\$(hyprctl monitors -j 2>/dev/null | jq -r '.[] | select(.focused) | .name' 2>/dev/null)
[ -z "\$MONITOR" ] && MONITOR=\$(hyprctl monitors -j 2>/dev/null | jq -r '.[0].name' 2>/dev/null)
[ -z "\$MONITOR" ] && MONITOR="eDP-1"

setsid /usr/bin/linux-wallpaperengine --assets-dir "\$ASSETS_DIR" --screen-root "\$MONITOR" --scaling "\${SCALING:-$SCALING}" --fps "\${FPS:-$FPS}" \$PAUSE_OPT \$AUDIO_OPT "\$CURRENT_TARGET" >/dev/null 2>&1 &

if [ "\${ROTATION_ENABLED:-false}" = "true" ]; then
    wallpaper-daemon start >/dev/null 2>&1 &
fi
EOF

chmod +x "$LAUNCH_SCRIPT"

# Restart the wallpaper
"$LAUNCH_SCRIPT"

TITLE="Unknown"
TYPE="Unknown"
if [ -f "$TARGET_DIR/project.json" ]; then
    TITLE=$(jq -r '.title // "Untitled"' "$TARGET_DIR/project.json" 2>/dev/null)
    TYPE=$(jq -r '.type // "unknown"' "$TARGET_DIR/project.json" 2>/dev/null)
fi

if [ "$QUIET" != "true" ]; then
    echo "Settings applied successfully!"
    echo "• Wallpaper : $TITLE (ID: $WALLPAPER_ID, Type: $TYPE)"
    echo "• Framerate     : $FPS FPS"
    if [ "$SILENT" == "true" ]; then
        echo "• Audio       : Muted"
    else
        echo "• Volume       : $VOLUME %"
    fi
    echo "• Scaling      : $SCALING"
    case "$PAUSE_MODE" in
        "only-active") echo "• Fullscreen  : Pause only if window is active" ;;
        "none")        echo "• Fullscreen  : Never pause" ;;
        "all")         echo "• Fullscreen  : Global pause across all workspaces" ;;
    esac
fi
